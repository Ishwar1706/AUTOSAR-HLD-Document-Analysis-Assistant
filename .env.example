# AUTOSAR HLD Document Analysis Assistant — Environment Configuration
# Copy this file to .env and fill in your actual values.

# --- LLM Provider (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- LLM Parameters ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Embedding Model ---
# Local model via sentence-transformers (no API key needed).
# First run requires internet to download ~130 MB model; cached after that.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Chunking ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
TOP_K_RETRIEVAL=6
